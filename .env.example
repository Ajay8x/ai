# AJAX AI Environment Configuration

# LLM Providers Configuration
# Supported providers: ajax_gguf, ajax_local, openai, groq, deepseek, openrouter, local_hf
DEFAULT_LLM_PROVIDER=ajax_gguf
LLM_MODEL=ajax-native-1.7b-q4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_THINKING_MODE=false
AUTO_TRAINING_ENABLED=true
AUTO_TRAINING_MIN_NEW_SAMPLES=10
AUTO_TRAINING_CHECK_INTERVAL_SECONDS=300
AUTO_TRAINING_COOLDOWN_SECONDS=1800
AUTO_TRAINING_INITIAL_DELAY_SECONDS=30

# API Keys (Set your respective key)
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
WEATHER_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Local quantized model path (the app falls back to AJAX Native Engine if absent)
LOCAL_MODEL_PATH=models/ajax-native-1.7b-q4_k_m.gguf

# Voice Configuration
VOICE_ENABLED=true
WAKE_WORD=ajax
WAKE_WORD_ENABLED=true
TTS_ENGINE=pyttsx3
STT_ENGINE=speech_recognition
STT_LANGUAGE=en-IN
STT_FALLBACK_LANGUAGES=hi-IN
VOICE_RATE=180
VOICE_VOLUME=1.0

# Database Configuration (MongoDB Atlas Cloud / PostgreSQL / SQLite)
DATABASE_TYPE=mongodb
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DB=ajax_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ajax_ai
# POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ajax_ai
DATABASE_PATH=data/ajax.db
MEMORY_VECTOR_DIM=384
PRIVACY_MODE=false
ALLOW_SQLITE_FALLBACK=true

# GraphRAG & Fast Search Engine (Meilisearch)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
MEILISEARCH_INDEX=ajax_graphrag
RAG_EMBEDDING_PROVIDER=auto
RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Cloudinary Cloud Storage
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Auth & Admin Secrets
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DEMO_LOGIN_ENABLED=false
DEMO_USERNAME=demo
DEMO_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

# Safety & Permissions
SAFETY_LEVEL=STANDARD
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE_ACTIONS=true

# Server & UI
HOST=127.0.0.1
PORT=8000
DEBUG=false
API_DOCS_ENABLED=false
MAX_UPLOAD_SIZE_MB=15
CORS_ORIGINS=

# Verified Public API Connectors (16 Providers)
# 14 providers are free public APIs requiring no authentication:
# (Open-Meteo, OpenSky Network, Where The ISS At?, CelesTrak, NOAA CO-OPS, USGS Earthquakes,
# NASA EONET, World Bank, Frankfurter FX, Nager.Date, REST Countries, OSM Nominatim,
# Mobility Database, JSONPlaceholder)
# The 2 providers below require developer API keys:
OPENAQ_API_KEY=          # Free API key from https://docs.openaq.org/ (Global Air Quality)
WINDY_API_KEY=           # Free API key from https://api.windy.com/webcams/docs (Global Webcams)

