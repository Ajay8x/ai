# AJAX AI Environment Configuration

# LLM Providers Configuration
# Supported providers: openai, llamafile, gguf, qwen3-4b, ollama, groq, deepseek, openrouter, local_hf
DEFAULT_LLM_PROVIDER=llamafile
LLM_MODEL=qwen3-4b-thinking-2507.Q4_K_M.gguf
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# API Keys (Set your respective key)
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# Ollama / Local Endpoints
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_PATH=

# Voice Configuration
VOICE_ENABLED=true
WAKE_WORD=ajax
WAKE_WORD_ENABLED=true
TTS_ENGINE=pyttsx3
STT_ENGINE=speech_recognition
VOICE_RATE=180
VOICE_VOLUME=1.0

# Database Configuration (PostgreSQL / SQLite)
DATABASE_TYPE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ajax_ai
# POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ajax_ai
DATABASE_PATH=data/ajax.db
MEMORY_VECTOR_DIM=384
PRIVACY_MODE=false

# Safety & Permissions
SAFETY_LEVEL=STANDARD
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE_ACTIONS=true

# Server & UI
HOST=127.0.0.1
PORT=8000
DEBUG=false
