# ==============================================================================
# AJAX AI - Comprehensive .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.dll

# Heavy LLM Model Weights & Large Checkpoints (>100MB Git Limits)
*.gguf
*.safetensors
*.bin
*.onnx
models/qwen3.5-9b/
models/qwen*/
qwen3-4b-thinking-*.gguf

# Standalone Executables & Llamafile Engines
llamafile*.exe
*.exe

# Environment, Secrets & Local Configs
.env
.env.local
.env.*.local
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
.gemini/
.agents/

# OS & Office Lock Files
.DS_Store
Thumbs.db
ehthumbs.db
~$*.docx
~$*.doc
~$*.xlsx
~$*.pptx
*.tmp

# SQLite Database & Runtime Data
data/*.db
data/ajax.db
data/screenshots/
data/vector_store/
data/query.txt
query.txt
memory.txt
backups/

# Logs & Telemetry
logs/
*.log

# Distribution, Packaging & Build Artifacts
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller & PyTest
*.manifest
*.spec
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
pytestdebug.log
